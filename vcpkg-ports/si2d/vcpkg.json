{
  "name": "si2d",
  "version-string": "0.1.0",
  "description": "2D sprite, shape and camera data for SIECS",
  "supports": "linux & x64",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "siecs",
      "features": [
        "spatial",
        "scene"
      ]
    },
    "sireflect"
  ],
  "features": {
    "raylib": {
      "description": "raylib renderer",
      "dependencies": [
        "raylib"
      ]
    }
  },
  "license": "MIT"
}
