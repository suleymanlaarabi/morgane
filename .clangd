Diagnostics:
  UnusedIncludes: None
CompileFlags:
  # bake writes repo-relative -I paths but clangd resolves them from each
  # project directory (client/, server/, net/): add the repo root back.
  Add: [-I..]
---
If:
  PathMatch: .*\.(h|hpp)
CompileFlags:
  Remove: [-std=c17]
  Add: [-xc++, -std=c++23]
